# Development-only credentials. Replace these outside a private local setup.
POSTGRES_DB=papertrail
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
S3_HOST_PORT=9000
S3_CONSOLE_HOST_PORT=9001
# Swagger UI and direct API access bind only to loopback.
API_HOST_PORT=8080
POSTGRES_USER=papertrail
POSTGRES_PASSWORD=local-only-change-me
REDIS_PASSWORD=local-only-change-me
S3_ACCESS_KEY=local-minio-access
S3_SECRET_KEY=local-minio-secret
S3_BUCKET=source-documents
# The bundled, self-hosted GROBID service stays on the private Compose network.
GROBID_BASE_URL=http://grobid:8070
GROBID_IMAGE=grobid/grobid:0.9.1-crf
GROBID_PARSER_VERSION=0.9.1-crf

# Upload caps are enforced as rejections; no file or extracted text is truncated.
PAPER_MAX_UPLOAD_BYTES=52428800
# Total multipart request cap, including form boundaries and configuration fields.
# Keep this slightly larger than PAPER_MAX_UPLOAD_BYTES when raising the file cap.
PAPER_MAX_REQUEST_SIZE=51MB
PAPER_MAX_PAGES=500
PAPER_MAX_CLAIM_CITATION_PAIRS=5000
PAPER_MAX_EXTRACTED_CHARACTERS=5000000
PAPER_MAX_EXTRACTED_CHARACTERS_PER_PAGE=100000
# Bounds the complete TEI response before XML parsing; 64 MiB by default.
PAPER_MAX_GROBID_RESPONSE_BYTES=67108864
PAPER_MAX_CITED_PAPER_BYTES=52428800
PAPER_MAX_CITED_PAPER_EXTRACTED_CHARACTERS=5000000
PAPER_MIN_EXTRACTED_CHARACTERS=100
PAPER_MIN_LANGUAGE_CONFIDENCE=0.65

# Reference matching policy and configured threshold are pinned in each Analysis Run.
# Numeric calibration against a labeled near-miss fixture remains a release gate.
PAPER_REFERENCE_RESOLUTION_CONFIDENCE_THRESHOLD=0.9

# Deterministic, per-run hybrid retrieval settings (PostgreSQL FTS + pgvector + RRF).
PAPER_RETRIEVAL_PROFILE_ID=postgres-hybrid-rrf-v1
PAPER_RETRIEVAL_VECTOR_CANDIDATES=10
PAPER_RETRIEVAL_LEXICAL_CANDIDATES=10
PAPER_RETRIEVAL_FINAL_CANDIDATES=5
PAPER_RETRIEVAL_RRF_CONSTANT=60

# Local Compose starts Ollama and downloads the configured model on first use.
# Ollama is offered as an option; new Analysis Runs still default to feature-hash embeddings.
OLLAMA_IMAGE=ollama/ollama:0.34.4
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text:v1.5
OLLAMA_DIMENSION=768
# Optional server-side bearer token; never sent to the browser or included in run snapshots.
OLLAMA_API_KEY=
# Hosts in this list are inside the operator-controlled deployment boundary; all others are EXTERNAL.
OLLAMA_TRUSTED_HOSTS=ollama,localhost,127.0.0.1
OLLAMA_REQUEST_TIMEOUT_MILLIS=60000
# Required only when the Ollama endpoint is outside the trusted-host list.
OLLAMA_EXTERNAL_ENABLEMENT_REVIEWED=false
OLLAMA_EXTERNAL_RETENTION_DISCLOSURE=

# Local consent-flow/acquisition testing defaults; verify terms and replace these disclosures before deployment.
CROSSREF_ENABLED=true
CROSSREF_ENABLEMENT_REVIEWED=true
CROSSREF_RETENTION_DISCLOSURE="Crossref mencatat IP peminta dan isi permintaan. Email polite pool dipakai untuk pemecahan masalah, dan Crossref menyatakan log dihapus setelah tiga bulan."
# Test placeholder only: configuring this sends provider_contact_email to Crossref and requires run consent.
CROSSREF_CONTACT_EMAIL=test@ptr.test
CROSSREF_CACHE_POSITIVE_TTL=30d
CROSSREF_CACHE_NEGATIVE_TTL=1h
# Set a strong server-side secret to enable the direct API-only cache invalidation endpoint.
OPERATOR_API_CREDENTIAL=

UNPAYWALL_ENABLED=true
UNPAYWALL_ENABLEMENT_REVIEWED=true
UNPAYWALL_RETENTION_DISCLOSURE="Unpaywall menerima DOI dan alamat kontak layanan; kebijakannya menyebut data permintaan dapat disimpan hingga enam bulan setelah penggunaan layanan berakhir. Repositori/host konten yang ditemukan memiliki ketentuan retensi tersendiri."
# Test placeholder only; consent also covers each outbound cited_paper_location URL.
UNPAYWALL_CONTACT_EMAIL=test@ptr.test
