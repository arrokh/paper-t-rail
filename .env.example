# Development-only credentials. Replace these outside a private local setup.
POSTGRES_DB=papertrail
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
S3_HOST_PORT=9000
S3_REGION=us-east-1
# Set false only when a compatible endpoint requires virtual-host addressing.
S3_PATH_STYLE_ACCESS=true
# Optional internal endpoint override for an external S3-compatible service.
# S3_ENDPOINT=https://s3.example.test
# Swagger UI and direct API access bind only to loopback.
API_HOST_PORT=8080
POSTGRES_USER=papertrail
POSTGRES_PASSWORD=local-only-change-me
REDIS_PASSWORD=local-only-change-me
S3_ACCESS_KEY=local-s3-access
S3_SECRET_KEY=local-s3-secret
S3_BUCKET=source-documents
# Exact browser origins allowed to upload directly to the recovery staging bucket.
S3_BROWSER_UPLOAD_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Optional browser-facing endpoint; Compose defaults to S3_ENDPOINT or the configured S3_HOST_PORT.
# S3_PUBLIC_ENDPOINT=https://s3.example.test
# The bundled, self-hosted GROBID service stays on the private Compose network.
GROBID_BASE_URL=http://grobid:8070
GROBID_IMAGE=grobid/grobid:0.9.1-crf
GROBID_PARSER_VERSION=0.9.1-crf
# Stage 04 uses local Docling for Cited Paper PDFs; Stage 01 remains on GROBID.
# The CPU service image is large and may download model artifacts on first startup.
DOCLING_IMAGE=ghcr.io/docling-project/docling-serve-cpu:v1.30.0
DOCLING_BASE_URL=http://docling:5001
CITED_PAPER_PARSER_ID=docling
CITED_PAPER_PARSER_VERSION=1.30.0
DOCLING_REQUEST_TIMEOUT_MILLIS=600000
DOCLING_MAX_SYNC_WAIT_SECONDS=600
# Enable Docling's local UI and OpenAPI docs by default; the service remains private on the Compose network.
DOCLING_SERVE_ENABLE_UI=true
DOCLING_SERVE_ENABLE_API_DOCS=true

# Upload caps are enforced as rejections; no file or extracted text is truncated.
PAPER_MAX_UPLOAD_BYTES=52428800
# Total multipart request cap, including form boundaries and configuration fields.
# Keep this slightly larger than PAPER_MAX_UPLOAD_BYTES when raising the file cap.
PAPER_MAX_REQUEST_SIZE=51MB
PAPER_MAX_PAGES=500
# Recovery file cap inherits PAPER_MAX_UPLOAD_BYTES in application.yml.
PAPER_RECOVERY_MAX_FILES_PER_BATCH=10
PAPER_RECOVERY_MAX_BATCH_BYTES=262144000
PAPER_RECOVERY_UPLOAD_URL_TTL_SECONDS=300
PAPER_RECOVERY_INACTIVITY_TTL_SECONDS=604800
PAPER_RECOVERY_IN_FLIGHT_GRACE_SECONDS=3600
PAPER_RECOVERY_CLEANUP_RETRY_WINDOW_SECONDS=604800
PAPER_RECOVERY_CLEANUP_INTERVAL_MS=3600000
PAPER_RECOVERY_CLEANUP_BATCH_SIZE=50
PAPER_MAX_CLAIM_CITATION_PAIRS=5000
PAPER_MAX_EXTRACTED_CHARACTERS=5000000
PAPER_MAX_EXTRACTED_CHARACTERS_PER_PAGE=100000
# Bounds the complete GROBID TEI response before XML parsing; 64 MiB by default.
PAPER_MAX_GROBID_RESPONSE_BYTES=67108864
# Bounds Docling's Markdown JSON response before parsing; 64 MiB by default.
PAPER_MAX_DOCLING_RESPONSE_BYTES=67108864
PAPER_MAX_CITED_PAPER_BYTES=52428800
PAPER_MAX_CITED_PAPER_EXTRACTED_CHARACTERS=5000000
PAPER_MIN_EXTRACTED_CHARACTERS=100
PAPER_MIN_LANGUAGE_CONFIDENCE=0.65

# The configured reference-matching threshold is pinned in each Analysis Run.
PAPER_REFERENCE_RESOLUTION_CONFIDENCE_THRESHOLD=0.25

# Per-run hybrid retrieval settings: independently ranked vector/lexical pools, then a final RRF cap.
# New runs snapshot these configurable values; changing them does not alter historical runs.
PAPER_RETRIEVAL_PROFILE_ID=postgres-hybrid-rrf-v1
PAPER_RETRIEVAL_VECTOR_CANDIDATES=3
PAPER_RETRIEVAL_LEXICAL_CANDIDATES=3
PAPER_RETRIEVAL_FINAL_CANDIDATES=3
PAPER_RETRIEVAL_RRF_CONSTANT=60

# Local Compose pulls Nomic for new runs; each run keeps its pinned embedding profile.
OLLAMA_IMAGE=ollama/ollama:0.40.1
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=nomic-embed-text:v1.5
OLLAMA_DIMENSION=768
# Optional server-side bearer token; never sent to the browser or included in run snapshots.
OLLAMA_API_KEY=
# Hosts in this list are inside the operator-controlled deployment boundary; all others are EXTERNAL.
OLLAMA_TRUSTED_HOSTS=ollama,localhost,127.0.0.1
OLLAMA_REQUEST_TIMEOUT_MILLIS=60000
# Optional retention/deletion note shown before per-run consent; blank is disclosed as unknown.
OLLAMA_EXTERNAL_RETENTION_DISCLOSURE=

# Local `make dev` starts the authenticated Laya sidecar and verifies/downloads its pinned model.
# Jev is the default preference when configured; the web form still requires explicit per-run consent.
SYSTEM_ONE_DEFAULT_PROVIDER=jev
LAYA_ENABLED=true
LAYA_BASE_URL=http://laya:8000
# `make dev` and `make laya-up` generate a random 256-bit local key when this value is empty.
LAYA_API_KEY=
LAYA_TRUSTED_HOSTS=laya,localhost,127.0.0.1
LAYA_REQUEST_TIMEOUT_MILLIS=120000
LAYA_THREADS=4

# Optional hosted TypeSafe Jev System One provider and default preference when configured.
# Keep the API key server-side; every run still requires explicit consent before claim/evidence transfer.
JEV_API_KEY=
JEV_MODEL=jev-latest
JEV_BASE_URL=https://api.typesafe.ai
JEV_REQUEST_TIMEOUT_MILLIS=120000
# Blank retention terms are displayed as unknown and do not block selection.
JEV_RETENTION_DISCLOSURE=

# Shared OpenAI-compatible Chat Completions connection profile; use-case adapters supply their own model and contract.
# In Compose, host.docker.internal reaches the host service; native Spring defaults to http://127.0.0.1:1234.
# The client adds /v1 when absent, probes /models without run content, then posts to /chat/completions.
OPENAI_COMPATIBLE_ENABLED=true
OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:1234
# Server-side secret; never exposed in provider listings or Analysis Run snapshots.
OPENAI_COMPATIBLE_API_KEY=
# Hosts within this deployment's trust boundary can use HTTP; external hosts must use HTTPS.
OPENAI_COMPATIBLE_TRUSTED_HOSTS=localhost,127.0.0.1,host.docker.internal
OPENAI_COMPATIBLE_MAX_REQUEST_BYTES=1048576
OPENAI_COMPATIBLE_MAX_RESPONSE_BYTES=1048576
OPENAI_COMPATIBLE_REQUEST_TIMEOUT_MILLIS=60000
# External provider retention/deletion uncertainty is disclosed; every external call still requires per-run consent.
OPENAI_COMPATIBLE_EXTERNAL_RETENTION_DISCLOSURE=

# Pipeline 01 claim-analysis adapter profile; provider/model are pinned per Analysis Run.
# Heuristic remains explicitly selectable and is never an implicit fallback.
CLAIM_ANALYSIS_DEFAULT_PROVIDER=openai-compatible-chat
CLAIM_ANALYSIS_OPENAI_COMPATIBLE_MODEL=google/gemma-4-e2b
CLAIM_ANALYSIS_OPENAI_COMPATIBLE_CONTEXT_WINDOW_TOKENS=131072
CLAIM_ANALYSIS_OPENAI_COMPATIBLE_MAX_COMPLETION_TOKENS=2048
# The request contains only Citation Contexts and minimal GROBID bibliography metadata, not raw TEI/full documents.

# Experimental aggregation uses one deterministic policy for eligible Laya and Jev runs.
# It defaults to true; results remain uncalibrated. Set false to leave final statuses NOT_RUN.
SYSTEM_ONE_AGGREGATION_ENABLED=true
SYSTEM_ONE_AGGREGATION_DIRECT_SUPPORT_THRESHOLD=0.80
SYSTEM_ONE_AGGREGATION_PARTIAL_SUPPORT_THRESHOLD=0.70
SYSTEM_ONE_AGGREGATION_CONTRADICTION_THRESHOLD=0.80
SYSTEM_ONE_AGGREGATION_COMPARABILITY_MARGIN=0.08

# Local consent-flow/acquisition testing defaults. These disclosures inform per-run choice, not enablement.
CROSSREF_ENABLED=true
CROSSREF_RETENTION_DISCLOSURE="Crossref mencatat IP peminta dan isi permintaan. Email polite pool dipakai untuk pemecahan masalah, dan Crossref menyatakan log dihapus setelah tiga bulan."
# Test placeholder only: configuring this sends provider_contact_email to Crossref and requires run consent.
CROSSREF_CONTACT_EMAIL=test@ptr.test
CROSSREF_CACHE_POSITIVE_TTL=30d
CROSSREF_CACHE_NEGATIVE_TTL=1h
# Set a strong server-side secret to enable the direct API-only cache invalidation endpoints.
OPERATOR_API_CREDENTIAL=

UNPAYWALL_ENABLED=true
UNPAYWALL_RETENTION_DISCLOSURE="Unpaywall menerima DOI dan alamat kontak layanan; kebijakannya menyebut data permintaan dapat disimpan hingga enam bulan setelah penggunaan layanan berakhir. Repositori/host konten yang ditemukan memiliki ketentuan retensi tersendiri."
# Test placeholder only; consent also covers each outbound cited_paper_location URL.
UNPAYWALL_CONTACT_EMAIL=test@ptr.test
UNPAYWALL_CACHE_POSITIVE_TTL=24h
UNPAYWALL_CACHE_NEGATIVE_TTL=1h
