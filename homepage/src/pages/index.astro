---
import "../styles/global.css";
import HeroScene from "../components/hero/HeroScene.astro";
import InteractiveDemo from "../components/InteractiveDemo.astro";
import CloudflareWebAnalytics from "../components/CloudflareWebAnalytics.astro";

const setupUrl = "https://github.com/arrokh/paper-t-rail";

const architecture = [
  {
    name: "Read the PDF",
    system: "Source parsing · claim extraction",
    detail: "Parse the uploaded PDF and persist its structure, citations, and Atomic Claims.",
    asset: "/images/architecture/stage-source.svg",
  },
  {
    name: "Resolve references",
    system: "Bibliography · identity matching",
    detail: "Resolve supported bibliography entries to canonical scholarly papers.",
    asset: "/images/architecture/stage-references.svg",
  },
  {
    name: "Acquire cited sources",
    system: "Legal full-text access",
    detail: "Discover eligible cited-paper sources and record their access provenance.",
    asset: "/images/architecture/stage-sources.svg",
  },
  {
    name: "Prepare evidence",
    system: "Parsing · chunking · retrieval",
    detail: "Prepare eligible cited full text and retrieve candidate Evidence Passages.",
    asset: "/images/architecture/stage-evidence.svg",
  },
  {
    name: "Assess evidence",
    system: "Passage judgement · aggregation",
    detail: "Record evidence judgements and aggregate Claim–Reference outcomes for review.",
    asset: "/images/architecture/stage-assessment.svg",
  },
];

const questions = [
  {
    question: "Does Paper T-Rail decide whether a claim is true?",
    answer:
      "No. The Evidence Coverage Report is a triage aid for human review, not a truth certification or academic grade.",
  },
  {
    question: "What can I analyze in V1?",
    answer:
      "V1 supports English, text-based academic PDFs. Scanned PDFs and other document types are outside this initial scope.",
  },
  {
    question: "Will my document be sent to an external provider?",
    answer:
      "Provider use is disclosed and consented to per analysis run. External or unclassified providers remain disabled until their data boundaries have been reviewed.",
  },
  {
    question: "Can I see what a report is based on?",
    answer:
      "The trace keeps claims, citation references, source locations, candidate passages, and run provenance connected for inspection.",
  },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7f0de" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta
      name="description"
      content="Follow citation-backed claims from your research draft to candidate evidence in cited papers, then make the review decision yourself."
    />
    <title>Paper T-Rail — A traceable paper trail from claim to cited evidence</title>
    <script is:inline>
      document.documentElement.classList.add("has-page-load-cover");

      if ("IntersectionObserver" in window) {
        document.documentElement.classList.add("has-scroll-nav");
      }

      const startPageLoadCoverExit = async () => {
        const pageLoadCover = document.querySelector(".page-load-cover");
        if (!pageLoadCover) return;

        const finishPageLoadCoverExit = () => {
          document.querySelector("main.landing-page")?.removeAttribute("inert");
          document.documentElement.classList.remove("has-page-load-cover");
          pageLoadCover.remove();
        };

        const pageImages = Array.from(document.images);
        pageImages.forEach((image) => {
          image.loading = "eager";
        });

        await Promise.all([
          document.fonts?.ready ?? Promise.resolve(),
          ...pageImages.map((image) => image.decode().catch(() => undefined)),
        ]);

        window.setTimeout(() => {
          if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            finishPageLoadCoverExit();
            return;
          }

          pageLoadCover.addEventListener("transitionend", (event) => {
            if (event.target === pageLoadCover) finishPageLoadCoverExit();
          }, { once: true });
          pageLoadCover.classList.add("is-exiting");
          window.setTimeout(finishPageLoadCoverExit, 1000);
        }, 2000);
      };

      if (document.readyState === "complete") {
        startPageLoadCoverExit();
      } else {
        window.addEventListener("load", startPageLoadCoverExit, { once: true });
      }
    </script>
  </head>
  <body>
    <div class="page-load-cover" role="status" aria-label="Loading Paper T-Rail">
      <div class="page-load-cover__identity">
        <span class="page-load-cover__brand">Paper T-Rail</span>
        <span class="page-load-cover__byline">by nooroctavian.id</span>
      </div>
      <span class="page-load-cover__track" aria-hidden="true">
        <span class="page-load-cover__window"></span>
        <span class="page-load-cover__window"></span>
        <span class="page-load-cover__window"></span>
        <span class="page-load-cover__window"></span>
        <span class="page-load-cover__window"></span>
      </span>
    </div>
    <main class="landing-page">
      <script is:inline>
        document.querySelector("main.landing-page")?.setAttribute("inert", "");
      </script>
  <header class="site-header">
    <a href="#top" class="site-brand" aria-label="Paper T-Rail home">
      <span>Paper T-Rail</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <a href="#about">About</a>
      <a href="#architecture">Architecture</a>
      <a href="#interactive-demo">Try the demo</a>
      <a href="#how-it-works">How it works</a>
      <a href="#faq">FAQ</a>
    </nav>
    <a
      href={setupUrl}
      class="landing-button landing-button--primary site-header__cta"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Set up the workspace (opens in a new tab)"
    >
      Set up the workspace <span class="pixel-icon icon-arrow-right" aria-hidden="true"></span>
    </a>
  </header>

  <section id="top" class="hero" aria-labelledby="hero-heading">
    <HeroScene />
    <div class="hero__content">
      <h1 id="hero-heading">Paper T-Rail</h1>
      <p class="hero__tagline">A traceable paper trail from claim to cited evidence</p>
      <div class="hero__actions">
        <a
          href={setupUrl}
          class="landing-button landing-button--primary"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Set up the workspace (opens in a new tab)"
        >
          Set up the workspace <span class="pixel-icon icon-arrow-right" aria-hidden="true"></span>
        </a>
        <a href="#about" class="hero__text-link">
          Learn more <span class="pixel-icon icon-arrow-down" aria-hidden="true"></span>
        </a>
      </div>
      <p class="hero__scope">* V0.1 · English, text-based academic PDFs</p>
    </div>
  </section>

  <section id="about" class="landing-section intro-section" aria-labelledby="intro-heading">
    <div class="landing-container">
      <div class="section-heading section-heading--center">
        <p class="pixel-label">Why Paper T-Rail</p>
        <h2 id="intro-heading">Research leaves a paper trail.</h2>
        <p>
          Paper T-Rail makes that trail traceable: follow a claim in your draft through its citation
          and cited paper to candidate evidence passages. “T-Rail” stands for Traceable Rail; the
          train and rails represent the path through those sources. Researchers inspect each link
          and decide what the evidence supports.
        </p>
      </div>
      <ol class="intro-trail" aria-label="The path from a claim to candidate evidence">
        <li><span class="intro-trail__step">01</span><span>Claim</span></li>
        <li><span class="intro-trail__step">02</span><span>Citation</span></li>
        <li><span class="intro-trail__step">03</span><span>Cited paper</span></li>
        <li><span class="intro-trail__step">04</span><span>Evidence passage</span></li>
      </ol>
      <div id="researchers" class="principle-grid">
        <article class="principle-card principle-card--red">
          <h3>Follow the reference.</h3>
          <p>Keep a claim connected to the citation and cited paper that it relies on.</p>
        </article>
        <article class="principle-card principle-card--gold">
          <h3>Bring the source closer.</h3>
          <p>Surface candidate passages and source locations for a researcher to inspect.</p>
        </article>
        <article class="principle-card principle-card--teal">
          <h3>Leave the decision with you.</h3>
          <p>The report helps with triage. It does not certify truth or grade a paper.</p>
        </article>
      </div>
    </div>
  </section>

  <section id="architecture" class="landing-section architecture-section" aria-labelledby="architecture-heading">
    <div class="landing-container">
      <div class="section-heading section-heading--split">
        <div>
          <p class="pixel-label">Under the hood</p>
          <h2 id="architecture-heading">A pipeline built for traceability.</h2>
        </div>
        <p>
          Each stage contributes to a recorded Analysis Run. The asynchronous design keeps document
          processing separate from the research workspace.
        </p>
      </div>
      <div class="architecture-ticket-carousel" data-ticket-carousel>
        <ol class="architecture-ticket-stack" data-ticket-stack aria-label="Five Analysis Run stage tickets">
          {architecture.map((step, index) => (
            <li
              class="architecture-ticket"
              data-ticket-item
              data-stage-name={step.name}
              data-stack-position={index === 0 ? "front" : index === 1 ? "next" : "back"}
              aria-current={index === 0 ? "step" : undefined}
              aria-hidden={index === 0 ? undefined : "true"}
              inert={index !== 0}
            >
              <div class="architecture-ticket__stub" aria-hidden="true">
                <span class="architecture-ticket__brand">Paper<br />T-Rail</span>
                <span class="architecture-ticket__number">{String(index + 1).padStart(2, "0")}</span>
                <span class="architecture-ticket__stub-caption">Analysis<br />Run</span>
              </div>
              <div class="architecture-ticket__content">
                <img
                  class="architecture-ticket__asset"
                  src={step.asset}
                  alt=""
                  width="112"
                  height="112"
                  loading={index === 0 ? "eager" : "lazy"}
                  decoding="async"
                />
                <span class="architecture-ticket__eyebrow">Next station</span>
                <h3>{step.name}</h3>
                <p class="architecture-ticket__system">{step.system}</p>
                <p class="architecture-ticket__detail">{step.detail}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="architecture-ticket-controls" role="group" aria-label="Pipeline ticket navigation">
          <button
            class="architecture-ticket-controls__button"
            type="button"
            data-ticket-previous
            aria-label="Show previous pipeline ticket"
          >
            <span class="pixel-icon icon-arrow-right architecture-ticket-controls__arrow architecture-ticket-controls__arrow--left" aria-hidden="true"></span>
            <span>Previous</span>
          </button>
          <output class="architecture-ticket-controls__status" data-ticket-status aria-live="polite" aria-atomic="true">
            01 / 05 · Read the PDF
          </output>
          <button
            class="architecture-ticket-controls__button"
            type="button"
            data-ticket-next
            aria-label="Show next pipeline ticket"
          >
            <span>Next</span>
            <span class="pixel-icon icon-arrow-right architecture-ticket-controls__arrow" aria-hidden="true"></span>
          </button>
        </div>
        <noscript>
          <p class="architecture-ticket-noscript">
            The ticket controls need JavaScript. Pipeline stages:
            {architecture.map((step, index) => String(index + 1).padStart(2, "0") + " " + step.name).join(" · ")}
          </p>
        </noscript>
      </div>
      <div class="architecture-notes">
        <article class="architecture-note architecture-note--consent">
          <p class="pixel-label">Consent stays with the run</p>
          <p>
            External providers receive data only when that provider is enabled and the required
            per-run consent is in place.
          </p>
        </article>
        <article class="architecture-note architecture-note--review">
          <p class="pixel-label">Human review stays distinct</p>
          <p>
            Machine results and human feedback are kept separate. Researchers inspect the report and
            decide what to do next.
          </p>
        </article>
      </div>
    </div>
  </section>

  <InteractiveDemo />

  <section id="how-it-works" class="landing-section how-it-works-section" aria-labelledby="how-it-works-heading">
    <div class="landing-container">
      <div class="section-heading section-heading--split">
        <div>
          <p class="pixel-label">How it works</p>
          <h2 id="how-it-works-heading">Follow the review from source to evidence.</h2>
        </div>
        <p>Watch how Paper T-Rail connects a paper&apos;s claims, citations and candidate evidence passages.</p>
      </div>
      <div class="how-it-works-video" aria-label="Video walkthrough preview">
        <iframe
          src="https://www.youtube-nocookie.com/embed/zj7WTlL2YlU?autoplay=0"
          title="How Paper T-Rail works"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="encrypted-media; picture-in-picture; web-share"
          allowfullscreen
          aria-hidden="true"
          tabindex="-1"
        ></iframe>
        <div class="how-it-works-video__cover" role="status">
          <span class="pixel-label">In progress</span>
          <strong>Walkthrough coming soon</strong>
          <span>We&apos;re preparing a guided look at the review flow.</span>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="landing-section faq-section" aria-labelledby="faq-heading">
    <div class="landing-container faq-layout">
      <div class="section-heading">
        <p class="pixel-label">Common questions</p>
        <h2 id="faq-heading">Questions researchers ask.</h2>
        <p>Clear boundaries make the evidence easier to trust and inspect.</p>
      </div>
      <div class="faq-list">
        {questions.map(({ question, answer }) => (
          <details>
            <summary>{question}</summary>
            <p>{answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <footer class="site-footer">
    <div class="site-footer__identity">
      <a href="#top" class="site-brand site-brand--footer" aria-label="Paper T-Rail home">
        <span>Paper T-Rail</span>
      </a>
      <a
        class="site-footer__byline"
        href="https://nooroctavian.id/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="by nooroctavian.id (opens in a new tab)"
      >by nooroctavian.id</a>
    </div>
  </footer>
    </main>

<script>
  const hero = document.querySelector<HTMLElement>("#top");
  const header = document.querySelector<HTMLElement>(".site-header");
  const documentElement = document.documentElement;

  if (hero && header && documentElement.classList.contains("has-scroll-nav")) {
    const navRevealBuffer = 12;
    const updateScrollNavVisibility = () => {
      documentElement.classList.toggle(
        "has-scroll-nav-visible",
        hero.getBoundingClientRect().bottom <= header.offsetHeight + navRevealBuffer,
      );
    };
    const headerObserver = new IntersectionObserver(updateScrollNavVisibility, {
      rootMargin: `-${header.offsetHeight + navRevealBuffer}px 0px 0px 0px`,
    });

    headerObserver.observe(hero);
    window.addEventListener("scroll", updateScrollNavVisibility, { passive: true });
    window.addEventListener("resize", updateScrollNavVisibility, { passive: true });
    updateScrollNavVisibility();
  }

</script>

<script is:inline>
  const heroForMotion = document.querySelector(".hero");
  const trainForMotion = document.querySelector(".train-consist--round-headlamp");
  const passengerCars = Array.from(document.querySelectorAll("[data-passenger-car]"));
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let pointerFrame = 0;
  let headlampTimer = 0;
  const carriageLightTimers = new Set();

  const randomBetween = (minimum, maximum) =>
    Math.floor(minimum + Math.random() * (maximum - minimum + 1));

  const scheduleCarriageLightTimer = (callback, delay) => {
    const timer = window.setTimeout(() => {
      carriageLightTimers.delete(timer);
      callback();
    }, delay);
    carriageLightTimers.add(timer);
  };

  const scheduleCarriageLightChange = (car, delay) => {
    if (reducedMotion.matches || !car.isConnected) return;
    scheduleCarriageLightTimer(() => {
      if (reducedMotion.matches || !car.isConnected) return;

      const litWindows = Array.from(car.querySelectorAll("[data-carriage-light]"))
        .filter((lightWindow) => lightWindow.getAttribute("data-carriage-light") !== "off");
      if (litWindows.length <= 2) {
        scheduleCarriageLightChange(car, randomBetween(2500, 10000));
        return;
      }

      for (let index = litWindows.length - 1; index > 0; index -= 1) {
        const swapIndex = Math.floor(Math.random() * (index + 1));
        [litWindows[index], litWindows[swapIndex]] = [litWindows[swapIndex], litWindows[index]];
      }

      const outageCount = randomBetween(1, Math.min(3, litWindows.length - 2));
      const darkenedWindows = litWindows.slice(0, outageCount);
      darkenedWindows.forEach((lightWindow) => lightWindow.setAttribute("data-carriage-light", "off"));

      scheduleCarriageLightTimer(() => {
        darkenedWindows.forEach((lightWindow) => lightWindow.setAttribute("data-carriage-light", "on"));
        scheduleCarriageLightChange(car, randomBetween(2500, 10000));
      }, randomBetween(4000, 30000));
    }, delay);
  };

  const resetCarriageLights = () => {
    carriageLightTimers.forEach((timer) => window.clearTimeout(timer));
    carriageLightTimers.clear();
    passengerCars.forEach((car) => {
      car.querySelectorAll("[data-carriage-light]").forEach((lightWindow) => {
        lightWindow.setAttribute("data-carriage-light", "on");
      });
    });
  };

  const resetHeroFogParallax = () => {
    heroForMotion?.style.setProperty("--hero-title-fog-x", "0px");
    heroForMotion?.style.setProperty("--hero-title-fog-y", "0px");
    heroForMotion?.style.setProperty("--hero-lake-fog-x", "0px");
    heroForMotion?.style.setProperty("--hero-lake-fog-y", "0px");
    heroForMotion?.style.setProperty("--hero-train-fog-x", "0px");
    heroForMotion?.style.setProperty("--hero-train-fog-y", "0px");
  };

  const updateHeroFogParallax = (event) => {
    if (!heroForMotion || reducedMotion.matches || event.pointerType === "touch") return;
    const bounds = heroForMotion.getBoundingClientRect();
    const horizontal = (event.clientX - bounds.left) / bounds.width - 0.5;
    const vertical = (event.clientY - bounds.top) / bounds.height - 0.5;
    window.cancelAnimationFrame(pointerFrame);
    pointerFrame = window.requestAnimationFrame(() => {
      heroForMotion.style.setProperty("--hero-title-fog-x", `${horizontal * 12}px`);
      heroForMotion.style.setProperty("--hero-title-fog-y", `${vertical * 8}px`);
      heroForMotion.style.setProperty("--hero-lake-fog-x", `${horizontal * 30}px`);
      heroForMotion.style.setProperty("--hero-lake-fog-y", `${vertical * 18}px`);
      heroForMotion.style.setProperty("--hero-train-fog-x", `${horizontal * -36}px`);
      heroForMotion.style.setProperty("--hero-train-fog-y", `${vertical * -22}px`);
    });
  };

  const setHeadlamp = (isOn) => trainForMotion?.setAttribute("data-headlamp", isOn ? "on" : "off");
  const scheduleHeadlampChange = () => {
    if (reducedMotion.matches || !trainForMotion) return;
    const isCurrentlyOn = trainForMotion.getAttribute("data-headlamp") !== "off";
    const delay = isCurrentlyOn ? randomBetween(8500, 18000) : randomBetween(1800, 4500);
    headlampTimer = window.setTimeout(() => {
      setHeadlamp(!isCurrentlyOn);
      scheduleHeadlampChange();
    }, delay);
  };

  const updateMotionPreference = () => {
    window.clearTimeout(headlampTimer);
    window.cancelAnimationFrame(pointerFrame);
    resetHeroFogParallax();
    resetCarriageLights();
    setHeadlamp(true);
    if (!reducedMotion.matches) {
      scheduleHeadlampChange();
      passengerCars.forEach((car) => scheduleCarriageLightChange(car, randomBetween(1200, 8000)));
    }
  };

  heroForMotion?.addEventListener("pointermove", updateHeroFogParallax, { passive: true });
  heroForMotion?.addEventListener("pointerleave", resetHeroFogParallax, { passive: true });
  reducedMotion.addEventListener("change", updateMotionPreference);
  updateMotionPreference();
</script>

<script>
  const ticketCarousel = document.querySelector<HTMLElement>("[data-ticket-carousel]");

  if (ticketCarousel) {
    const tickets = Array.from(ticketCarousel.querySelectorAll<HTMLElement>("[data-ticket-item]"));
    const previousButton = ticketCarousel.querySelector<HTMLButtonElement>("[data-ticket-previous]");
    const nextButton = ticketCarousel.querySelector<HTMLButtonElement>("[data-ticket-next]");
    const status = ticketCarousel.querySelector<HTMLOutputElement>("[data-ticket-status]");
    let activeTicketIndex = 0;

    if (tickets.length > 0 && previousButton && nextButton && status) {
      const updateActiveTicket = (nextIndex: number) => {
        activeTicketIndex = (nextIndex + tickets.length) % tickets.length;

        tickets.forEach((ticket, index) => {
          const position = (index - activeTicketIndex + tickets.length) % tickets.length;
          const stackPosition =
            position === 0
              ? "front"
              : position === 1
                ? "next"
                : position === tickets.length - 1
                  ? "previous"
                  : "back";

          ticket.dataset.stackPosition = stackPosition;
          ticket.toggleAttribute("aria-hidden", position !== 0);
          ticket.inert = position !== 0;

          if (position === 0) {
            ticket.setAttribute("aria-current", "step");
          } else {
            ticket.removeAttribute("aria-current");
          }
        });

        const activeTicket = tickets[activeTicketIndex];
        const stageNumber = String(activeTicketIndex + 1).padStart(2, "0");
        status.textContent =
          stageNumber +
          " / " +
          String(tickets.length).padStart(2, "0") +
          " · " +
          (activeTicket.dataset.stageName ?? "");
      };

      const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const stampDuration = prefersReducedMotion ? 0 : 420;
      let isTransitioning = false;

      const transitionToTicket = (offset: number, stamp: boolean) => {
        if (isTransitioning) return;
        if (!stamp || stampDuration === 0) {
          updateActiveTicket(activeTicketIndex + offset);
          return;
        }

        isTransitioning = true;
        const outgoingTicket = tickets[activeTicketIndex];
        outgoingTicket.dataset.stamping = "true";
        previousButton.disabled = true;
        nextButton.disabled = true;

        window.setTimeout(() => {
          delete outgoingTicket.dataset.stamping;
          updateActiveTicket(activeTicketIndex + offset);
          window.setTimeout(() => {
            previousButton.disabled = false;
            nextButton.disabled = false;
            isTransitioning = false;
          }, 300);
        }, stampDuration);
      };

      previousButton.addEventListener("click", () => transitionToTicket(-1, false));
      nextButton.addEventListener("click", () => transitionToTicket(1, true));
      updateActiveTicket(activeTicketIndex);
    }
  }
</script>

    <CloudflareWebAnalytics />
  </body>
</html>
