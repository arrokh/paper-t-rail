---
interface TrainSegment {
  width: string;
  sourceStart: string;
  windowLefts?: number[];
  windowWidth?: string;
}

interface Props {
  className?: string;
  loading?: "eager" | "lazy";
}

const { className = "", loading = "lazy" } = Astro.props;

const segments: TrainSegment[] = [
  { width: "0.244", sourceStart: "0", windowLefts: [24.6, 34.6, 45, 55.6, 66, 76.4], windowWidth: "5.6%" },
  { width: "0.2", sourceStart: "0.244", windowLefts: [8.6, 21.6, 34.3, 46.9, 59.9, 72.6], windowWidth: "6.9%" },
  { width: "0.2", sourceStart: "0.444", windowLefts: [10.9, 23.9, 36.5, 49, 61.7, 74.6], windowWidth: "6.9%" },
  { width: "0.204", sourceStart: "0.644" },
];
---

<div
  class:list={["train-consist", "train-consist--round-headlamp", className]}
  style={`--locomotive-motion-delay: ${(segments.length - 1) * 240}ms`}
  aria-hidden="true"
>
  {
    segments.map((segment, index) => (
      <span
        class="train-consist__car"
        data-passenger-car={segment.windowLefts ? "true" : undefined}
        style={`--segment-width: ${segment.width}; --sprite-start: ${segment.sourceStart}; --car-delay: ${index * 240}ms`}
      >
        <img
          src="/images/hero/train.png"
          alt=""
          width="2048"
          height="300"
          loading={loading}
          decoding="async"
          draggable="false"
        />
        {segment.windowLefts?.map((left) => (
          <span
            class="train-consist__window"
            data-carriage-light="on"
            style={`--window-left: ${left}%; --window-width: ${segment.windowWidth ?? "6%"}`}
          ></span>
        ))}
      </span>
    ))
  }
</div>
