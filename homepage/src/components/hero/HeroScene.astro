---
import HeroBridge from "./HeroBridge.astro";
import HeroCloud from "./HeroCloud.astro";
import HeroMoon from "./HeroMoon.astro";
import HeroStar from "./HeroStar.astro";
import HeroTrain from "./HeroTrain.astro";
---

<div class="hero-scene" aria-hidden="true">
  <HeroStar left="8%" top="16%" size="28px" delay="1.8s" />
  <HeroStar left="30%" top="13%" size="24px" delay="0.2s" />
  <HeroStar left="50%" top="15%" size="22px" delay="2.2s" />
  <HeroStar left="72%" top="19%" size="26px" delay="2.6s" />
  <HeroStar left="88%" top="16%" size="24px" delay="0.8s" />
  <HeroStar left="94%" top="13%" size="22px" delay="1s" />
  <HeroStar left="25%" top="18%" size="20px" delay="3s" />
  <HeroStar left="81%" top="20%" size="20px" delay="1.4s" />
  <HeroStar left="12%" top="11%" size="24px" delay="3.4s" />
  <HeroStar left="65%" top="17%" size="22px" delay="2.8s" />
  <HeroStar left="3%" top="22%" size="18px" delay="1.2s" />
  <HeroStar left="41%" top="9%" size="18px" delay="2.4s" />
  <HeroStar left="58%" top="11%" size="18px" delay="0.6s" />
  <HeroStar left="68%" top="7%" size="18px" delay="3.2s" />
  <HeroStar left="35%" top="20%" size="16px" delay="1.6s" />
  <HeroStar left="97%" top="23%" size="16px" delay="0.4s" />
  <HeroCloud variant="far-left" left="20%" top="14%" width="min(38vw, 560px)" duration="240s" />
  <HeroCloud variant="near-left" left="4%" top="22%" width="min(29vw, 420px)" duration="155s" />
  <HeroCloud variant="right" left="77%" top="18%" width="min(21vw, 300px)" duration="118s" />
  <HeroCloud variant="high-right" left="57%" top="10%" width="min(12vw, 170px)" duration="196s" />
  <HeroMoon />
  <div class="hero-scene__title-fog"></div>
  <div class="hero-scene__lake-fog"></div>
  <HeroBridge />
  <HeroTrain />
</div>
